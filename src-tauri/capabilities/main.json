{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The initial main window has no filesystem or network plugin permissions.",
  "windows": ["main", "workspace-*"],
  "permissions": ["core:default", "core:window:allow-set-size", "core:app:allow-exit", "core:window:allow-start-dragging", "core:window:allow-set-theme", "core:window:allow-set-background-color"]
}
