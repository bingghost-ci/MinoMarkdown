{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mino",
  "version": "0.1.0",
  "identifier": "app.mino.markdown",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "visible": false, "title": "Mino", "width": 1100, "height": 760, "minWidth": 720, "minHeight": 520 }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: mino-asset:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main"]
    }
  },
  "bundle": { "active": true, "targets": ["app"], "macOS": { "minimumSystemVersion": "12.0" }, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"], "fileAssociations": [{"ext": ["md", "markdown"], "mimeType": "text/markdown", "role": "Editor", "rank": "Alternate", "name": "Markdown Document"}, {"ext": ["txt", "text"], "mimeType": "text/plain", "role": "Editor", "rank": "Alternate", "name": "Plain Text Document"}, {"ext": ["log", "json", "jsonc", "yaml", "yml", "toml", "xml", "csv", "tsv", "ini", "conf", "cfg", "properties", "sh", "bash", "zsh", "py", "js", "mjs", "cjs", "jsx", "ts", "tsx", "rs", "go", "java", "kt", "swift", "c", "h", "cpp", "cc", "hpp", "cs", "rb", "php", "lua", "sql", "css", "scss", "less", "html", "htm", "vue", "tex", "diff", "patch", "bat", "ps1", "gradle"], "role": "Editor", "rank": "Alternate", "name": "Source or Data File"}, {"ext": ["pdf"], "mimeType": "application/pdf", "role": "Viewer", "rank": "Alternate", "name": "PDF Document"}] }
}
