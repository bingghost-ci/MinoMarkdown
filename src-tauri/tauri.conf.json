{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mino",
  "version": "0.1.0",
  "identifier": "app.mino.markdown",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "visible": false, "title": "Mino", "width": 1100, "height": 760, "minWidth": 720, "minHeight": 520, "titleBarStyle": "Overlay", "hiddenTitle": true, "trafficLightPosition": { "x": 16, "y": 24 } }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: mino-asset:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main"]
    }
  },
  "bundle": {"active": true, "targets": ["app"], "macOS": {"minimumSystemVersion": "12.0"}, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"], "fileAssociations": [{"ext": ["md", "markdown"], "contentTypes": ["net.daringfireball.markdown"], "mimeType": "text/markdown", "role": "Editor", "rank": "Alternate", "name": "Markdown Document"}, {"ext": ["txt", "text"], "contentTypes": ["public.plain-text"], "mimeType": "text/plain", "role": "Editor", "rank": "Alternate", "name": "Plain Text Document"}, {"ext": ["log", "json", "yaml", "yml", "toml", "xml", "csv", "tsv", "ini", "cfg", "sh", "bash", "zsh", "py", "js", "mjs", "tsx", "java", "swift", "c", "h", "cpp", "cc", "hpp", "rb", "php", "sql", "css", "html", "htm", "diff", "patch"], "contentTypes": ["com.apple.log", "public.json", "public.yaml", "public.toml", "public.xml", "public.comma-separated-values-text", "public.tab-separated-values-text", "com.microsoft.ini", "public.shell-script", "public.bash-script", "public.zsh-script", "public.python-script", "com.netscape.javascript-source", "com.microsoft.typescript", "com.sun.java-source", "public.swift-source", "public.c-source", "public.c-header", "public.c-plus-plus-source", "public.c-plus-plus-header", "public.ruby-script", "public.php-script", "org.iso.sql", "public.css", "public.html", "public.patch-file"], "role": "Editor", "rank": "Alternate", "name": "Source or Data File"}, {"ext": ["jsonc", "conf", "properties", "cjs", "jsx", "ts", "rs", "go", "kt", "cs", "lua", "scss", "less", "vue", "tex", "bat", "ps1", "gradle"], "role": "Editor", "rank": "Alternate", "name": "Source File"}, {"ext": ["pdf"], "contentTypes": ["com.adobe.pdf"], "mimeType": "application/pdf", "role": "Viewer", "rank": "Alternate", "name": "PDF Document"}, {"ext": [], "contentTypes": ["public.folder"], "role": "Viewer", "rank": "Alternate", "name": "Folder"}]}
}
